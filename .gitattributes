# Git LFS - large binary files
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text

# Line endings - normalize to LF in the repo, CRLF on Windows checkout
* text=auto

# C++ source files - always LF
*.cpp text eol=lf
*.h   text eol=lf

# Text documents - LF
*.md  text eol=lf
*.txt text eol=lf

# Binary assets - no line-ending conversion
*.odt binary
